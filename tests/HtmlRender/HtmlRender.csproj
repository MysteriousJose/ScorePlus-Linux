<Project Sdk="Microsoft.NET.Sdk">
  <!-- The HTML element is checked on every OS, not only where a Windows browser runtime exists.
       HtmlSurface's contract is the same everywhere: a real frame when a browser is available,
       an explained placeholder when it is not, and never a crash. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Scoreboard.Desktop/Scoreboard.Desktop.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>
</Project>
