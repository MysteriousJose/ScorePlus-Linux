<Application x:Class="Scoreboard.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#080808"/><SolidColorBrush x:Key="Surface" Color="#141414"/><SolidColorBrush x:Key="Accent" Color="#38D7A3"/><SolidColorBrush x:Key="Muted" Color="#A8B4C3"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#090D12"/><Setter Property="BorderBrush" Value="#334155"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="16"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#000000"/><Setter Property="BorderBrush" Value="#383838"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="4"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="Background" Value="#080808"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#303030"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#202020"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
</Application.Resources></Application>
