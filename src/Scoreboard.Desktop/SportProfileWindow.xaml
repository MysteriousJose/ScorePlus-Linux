<Window x:Class="Scoreboard.Desktop.SportProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScorePlus — Sport Profiles" Width="760" Height="700" MinWidth="660" MinHeight="560" WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,14,0">
      <TextBlock DockPanel.Dock="Top" Text="SPORT PROFILES" FontSize="14" FontWeight="Bold" Margin="4,0,0,8"/>
      <TextBlock DockPanel.Dock="Bottom" Text="Built-in presets can be edited too — those changes are saved as an override. New profile starts one from scratch." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="4,8,4,0"/>
      <ListBox x:Name="Profiles" Background="#10151D" Foreground="White" BorderBrush="#364151" SelectionChanged="Profiles_SelectionChanged"/>
    </DockPanel>

    <Border Grid.Column="1" Grid.Row="0" Background="#171C25" CornerRadius="8" Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="PROFILE SETTINGS" FontWeight="Bold" Margin="2,0,0,10"/>
          <TextBlock Text="Display name" Foreground="#93A0B2" Margin="2,0,0,2"/>
          <TextBox x:Name="NameInput"/>
          <TextBlock Text="Period / segment label (Quarter, Half, Inning…)" Foreground="#93A0B2" Margin="2,6,0,2"/>
          <TextBox x:Name="UnitInput"/>
          <UniformGrid Columns="2">
            <StackPanel>
              <TextBlock Text="Number of periods" Foreground="#93A0B2" Margin="2,6,0,2"/>
              <TextBox x:Name="PeriodsInput"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Period length in minutes (0 = untimed)" Foreground="#93A0B2" Margin="2,6,0,2"/>
              <TextBox x:Name="MinutesInput"/>
            </StackPanel>
          </UniformGrid>
          <UniformGrid Columns="2">
            <StackPanel>
              <TextBlock Text="Timeouts per team" Foreground="#93A0B2" Margin="2,6,0,2"/>
              <TextBox x:Name="TimeoutsInput"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Score buttons (comma separated)" Foreground="#93A0B2" Margin="2,6,0,2"/>
              <TextBox x:Name="ScoringInput"/>
            </StackPanel>
          </UniformGrid>
          <CheckBox x:Name="CountUpInput" Content="Clock counts up instead of down" Foreground="White" Margin="6,10,0,0"/>
          <CheckBox x:Name="ShotClockInput" Content="Has a shot clock" Foreground="White" Margin="6,4,0,0"/>

          <!-- The sport's own console values and their starting numbers. -->
          <Separator Margin="2,12,2,0"/>
          <DockPanel Margin="2,8,2,0">
            <Button x:Name="AddValueButton" DockPanel.Dock="Right" Content="＋ Add value" FontSize="11"
                    Padding="9,5" MinHeight="28" Margin="6,0,0,0" Click="AddValue_Click"
                    ToolTip="Add another value or on/off switch to this sport's console"/>
            <TextBlock Text="SPORT VALUES" FontSize="11" FontWeight="Bold" Foreground="#93A0B2" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="What the console shows for this sport — balls, strikes and bases, power play, overs and wickets, sets. The number is the starting value of a new game, and every one of these can be printed on the scorebug as a sport data element."
                     TextWrapping="Wrap" FontSize="11" Foreground="#93A0B2" Margin="4,2,4,4"/>
          <StackPanel x:Name="ControlsHost"/>
          <TextBlock x:Name="BuiltInNote" Text="Built-in preset — saving stores your version as an override." TextWrapping="Wrap" Foreground="#93A0B2" Margin="4,10,4,0"/>
          <TextBlock x:Name="ErrorText" Foreground="#FF7272" TextWrapping="Wrap" Margin="4,8,4,0"/>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="NewProfileButton" Content="New profile" Click="NewProfile_Click"
                    ToolTip="Start a custom sport from scratch: blank settings, not a copy of another sport"/>
            <Button x:Name="SaveButton" Content="Save profile" Click="Save_Click"/>
            <Button x:Name="DuplicateButton" Content="Duplicate" Click="Duplicate_Click"/>
            <Button x:Name="ResetButton" Content="Reset to preset" Click="Reset_Click"/>
            <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
      <TextBlock Text="Profiles apply to every new game started with that sport." VerticalAlignment="Center" Foreground="#93A0B2"/>
      <Button DockPanel.Dock="Right" Content="Done" IsDefault="True" Click="Done_Click" Margin="4,0,0,0"/>
    </DockPanel>
  </Grid>
</Window>
