<Window x:Class="Scoreboard.Desktop.SportProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sport Profiles" Width="660" Height="590" MinWidth="600" MinHeight="520" WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI"><Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,16,0"><TextBlock DockPanel.Dock="Top" Text="SPORT PROFILES" FontSize="14" FontWeight="Bold" Margin="4,0,0,10"/><ListBox x:Name="Profiles" Background="#171C25" Foreground="White" BorderBrush="#364151" SelectionChanged="Profiles_SelectionChanged"/></DockPanel><ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="PROFILE SETTINGS" FontWeight="Bold" Margin="4,0,0,8"/><TextBlock Text="Display name" Foreground="#93A0B2"/><TextBox x:Name="NameInput"/><TextBlock Text="Period / segment label" Foreground="#93A0B2"/><TextBox x:Name="UnitInput"/><TextBlock Text="Number of periods" Foreground="#93A0B2"/><TextBox x:Name="PeriodsInput"/><TextBlock Text="Period length in minutes (0 = untimed)" Foreground="#93A0B2"/><TextBox x:Name="MinutesInput"/><CheckBox x:Name="CountUpInput" Content="Clock counts up" Foreground="White" Margin="8"/><TextBlock Text="Score buttons (comma-separated points)" Foreground="#93A0B2"/><TextBox x:Name="ScoringInput"/><TextBlock x:Name="BuiltInNote" Text="Built-in preset — duplicate it to customize without altering the original." TextWrapping="Wrap" Foreground="#93A0B2" Margin="6,8"/><TextBlock x:Name="ErrorText" Foreground="#FF7272" TextWrapping="Wrap" Margin="6"/><WrapPanel><Button x:Name="DuplicateButton" Content="Duplicate preset" Click="Duplicate_Click"/><Button x:Name="SaveButton" Content="Save custom sport" Click="Save_Click"/><Button x:Name="DeleteButton" Content="Delete custom" Click="Delete_Click"/></WrapPanel></StackPanel></ScrollViewer><DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"><TextBlock Text="User sports save locally and are available in every new game." VerticalAlignment="Center" Foreground="#93A0B2"/><Button DockPanel.Dock="Right" Content="Done" IsDefault="True" Click="Done_Click" Margin="4,0,0,0"/></DockPanel></Grid></Window>