<Window x:Class="Scoreboard.Desktop.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus" Width="600" Height="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#050607" Foreground="#F4F7FB"
        FontFamily="Segoe UI" ShowInTaskbar="True">
  <Window.Resources>
    <Style x:Key="LaunchPrimary" TargetType="Button">
      <Setter Property="Width" Value="230"/>
      <Setter Property="Height" Value="62"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,14,0"/>
      <Setter Property="Background" Value="#0B6B50"/>
      <Setter Property="BorderBrush" Value="#14A67C"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="LaunchSecondary" TargetType="Button" BasedOn="{StaticResource LaunchPrimary}">
      <Setter Property="Background" Value="#161C24"/>
      <Setter Property="BorderBrush" Value="#2E3B4A"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="72"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Margin="38,34,30,30" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="10" Height="10" CornerRadius="5" Background="#38D7A3" Margin="0,0,10,0"/>
        <TextBlock Text="SCOREPLUS" FontSize="40" FontWeight="Bold" Foreground="#F4F7FB"/>
      </StackPanel>
      <TextBlock Text="Live scorebug control for American football and more." Foreground="#93A0B2" FontSize="13" Margin="2,8,0,0"/>
      <TextBlock Text="Start a fresh game, or open one you saved." Foreground="#5C6B7E" FontSize="12" Margin="2,3,0,0"/>

      <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
        <Button x:Name="NewGameButton" Style="{StaticResource LaunchPrimary}" Content="New Game" Click="NewGame_Click" IsDefault="True"/>
        <Button x:Name="OpenGameButton" Style="{StaticResource LaunchSecondary}" Content="Open Game" Click="OpenGame_Click"/>
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" Background="#0A0D11" BorderBrush="#151B23" BorderThickness="1,0,0,0">
      <TextBlock x:Name="VersionText" Text="v0.0" Foreground="#5C6B7E" FontSize="12" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"
                 RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
          <RotateTransform Angle="-90"/>
        </TextBlock.RenderTransform>
      </TextBlock>
    </Border>
  </Grid>
</Window>
