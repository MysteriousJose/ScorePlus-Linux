<Window x:Class="Scoreboard.Desktop.GameControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game Control Panel" Width="720" Height="850" MinWidth="600" MinHeight="680" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI"><DockPanel><Border DockPanel.Dock="Top" Background="#171C25" Padding="16"><StackPanel><TextBlock Text="GAME CONTROL PANEL" FontSize="18" FontWeight="Bold"/><TextBlock Text="Quick reference: SPACE starts/stops the clock · Home/Away score buttons update the live output · Ctrl+Z undoes the last action" TextWrapping="Wrap" Foreground="#93A0B2" Margin="0,5,0,0"/></StackPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><Border Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="SCORE &amp; POSSESSION" FontWeight="Bold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HomeTitle" Text="HOME" HorizontalAlignment="Center" FontWeight="Bold" Margin="4"/><TextBlock x:Name="HomeScore" Text="0" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button Content="+1" Tag="1" Click="HomeScore_Click"/><Button Content="+2" Tag="2" Click="HomeScore_Click"/><Button Content="+3" Tag="3" Click="HomeScore_Click"/></UniformGrid><Button Content="Timeout" Click="HomeTimeout_Click"/><TextBlock x:Name="HomeFouls" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="AwayTitle" Text="AWAY" HorizontalAlignment="Center" FontWeight="Bold" Margin="4"/><TextBlock x:Name="AwayScore" Text="0" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button Content="+1" Tag="1" Click="AwayScore_Click"/><Button Content="+2" Tag="2" Click="AwayScore_Click"/><Button Content="+3" Tag="3" Click="AwayScore_Click"/></UniformGrid><Button Content="Timeout" Click="AwayTimeout_Click"/><TextBlock x:Name="AwayFouls" HorizontalAlignment="Center"/></StackPanel></Grid><Button Content="Toggle possession" Click="Possession_Click"/></StackPanel></Border><Border Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="CLOCK &amp; PERIOD" FontWeight="Bold"/><TextBlock x:Name="PeriodLabel" DockPanel.Dock="Right" Foreground="#93A0B2"/></DockPanel><TextBlock x:Name="Clock" FontSize="42" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button x:Name="ClockToggle" Content="Start clock" Click="Clock_Click"/><Button Content="−1 min" Click="Minus_Click"/><Button Content="+1 min" Click="Plus_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="−1 sec" Click="MinusSecond_Click"/><Button Content="Set clock" Click="SetClock_Click"/><Button Content="+1 sec" Click="PlusSecond_Click"/></UniformGrid><Button Content="Next period" Click="NextPeriod_Click"/></StackPanel></Border><Border x:Name="FootballPanel" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="AMERICAN FOOTBALL · DOWN &amp; DISTANCE" FontWeight="Bold"/><TextBlock x:Name="DownDisplay" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="4"/><TextBlock x:Name="BallDisplay" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button Content="Next down" Click="NextDown_Click"/><Button Content="Distance −1 yd" Click="DistanceMinus_Click"/><Button Content="Distance +1 yd" Click="DistancePlus_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="Ball −5 yd" Click="BallMinus_Click"/><Button Content="Ball +5 yd" Click="BallPlus_Click"/><Button Content="New series" Click="NewSeries_Click"/></UniformGrid></StackPanel></Border><Border x:Name="SoccerPanel" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="SOCCER · DISCIPLINE" FontWeight="Bold"/><UniformGrid Columns="2"><Button Content="Home yellow card" Click="HomeYellow_Click"/><Button Content="Away yellow card" Click="AwayYellow_Click"/><Button Content="Home red card" Click="HomeRed_Click"/><Button Content="Away red card" Click="AwayRed_Click"/></UniformGrid><TextBlock x:Name="CardsDisplay" HorizontalAlignment="Center" FontSize="16" Margin="8"/></StackPanel></Border><Button Content="Undo last action  ·  Ctrl+Z" Click="Undo_Click"/></StackPanel></ScrollViewer></DockPanel></Window>