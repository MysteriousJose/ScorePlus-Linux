<Window x:Class="Scoreboard.Desktop.GameControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Game Control Panel" Width="720" Height="850" MinWidth="600" MinHeight="680" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI"><DockPanel><Border DockPanel.Dock="Top" Background="#171C25" Padding="16"><StackPanel><TextBlock Text="GAME CONTROL PANEL" FontSize="18" FontWeight="Bold"/><TextBlock Text="Scores and clocks publish live automatically. Update Output publishes staged game details such as down and distance. SPACE starts/stops the clock · Ctrl+Z undoes" TextWrapping="Wrap" Foreground="#93A0B2" Margin="0,5,0,0"/></StackPanel></Border><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><Border Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="SCORE &amp; POSSESSION" FontWeight="Bold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="HomeTitle" Text="HOME" HorizontalAlignment="Center" FontWeight="Bold" Margin="4"/><TextBlock x:Name="HomeScore" Text="0" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="4"><Button Content="+1" Tag="Score+1" Click="HomeScore_Click"/><Button Content="+2" Tag="Score+2" Click="HomeScore_Click"/><Button Content="+3" Tag="Score+3" Click="HomeScore_Click"/><Button x:Name="HomeTouchdownScore" Content="+6 TD" Tag="Score+6" Click="HomeScore_Click"/></UniformGrid><UniformGrid Columns="4"><Button Content="−1" Tag="Score-1" Click="HomeScore_Click"/><Button Content="−2" Tag="Score-2" Click="HomeScore_Click"/><Button Content="−3" Tag="Score-3" Click="HomeScore_Click"/><Button x:Name="HomeTouchdownSubtract" Content="−6" Tag="Score-6" Click="HomeScore_Click"/></UniformGrid><Button Tag="Timeout" Content="Timeout" Click="HomeTimeout_Click"/><TextBlock x:Name="HomeFouls" HorizontalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="AwayTitle" Text="AWAY" HorizontalAlignment="Center" FontWeight="Bold" Margin="4"/><TextBlock x:Name="AwayScore" Text="0" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="4"><Button Content="+1" Tag="Score+1" Click="AwayScore_Click"/><Button Content="+2" Tag="Score+2" Click="AwayScore_Click"/><Button Content="+3" Tag="Score+3" Click="AwayScore_Click"/><Button x:Name="AwayTouchdownScore" Content="+6 TD" Tag="Score+6" Click="AwayScore_Click"/></UniformGrid><UniformGrid Columns="4"><Button Content="−1" Tag="Score-1" Click="AwayScore_Click"/><Button Content="−2" Tag="Score-2" Click="AwayScore_Click"/><Button Content="−3" Tag="Score-3" Click="AwayScore_Click"/><Button x:Name="AwayTouchdownSubtract" Content="−6" Tag="Score-6" Click="AwayScore_Click"/></UniformGrid><Button Tag="Timeout" Content="Timeout" Click="AwayTimeout_Click"/><TextBlock x:Name="AwayFouls" HorizontalAlignment="Center"/></StackPanel></Grid><Button Tag="Possession" Content="Toggle possession" Click="Possession_Click"/><ToggleButton x:Name="LiveOutputToggle" Content="Live score &amp; clock: ON" IsChecked="True" Checked="LiveOutput_Changed" Unchecked="LiveOutput_Changed" Margin="4" Padding="12,10"/><TextBlock x:Name="LiveOutputStatus" Text="MANUAL OUTPUT" Foreground="#93A0B2" HorizontalAlignment="Center"/><Button x:Name="UpdateScoreButton" Content="Update Output (publish current game state)" FontSize="16" Padding="14,14" Background="#087A5A" Click="UpdateScore_Click"/></StackPanel></Border><Border Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8"><StackPanel><DockPanel><TextBlock Text="CLOCK &amp; PERIOD" FontWeight="Bold"/><TextBlock x:Name="PeriodLabel" DockPanel.Dock="Right" Foreground="#93A0B2"/></DockPanel><TextBlock x:Name="Clock" FontSize="42" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button x:Name="ClockToggle" Tag="Clock" Content="Start clock" Click="Clock_Click"/><Button Tag="ClockAdjust" Content="−1 min" Click="Minus_Click"/><Button Tag="ClockAdjust" Content="+1 min" Click="Plus_Click"/></UniformGrid><UniformGrid Columns="3"><Button Tag="ClockAdjust" Content="−1 sec" Click="MinusSecond_Click"/><Button Tag="ClockAdjust" Content="Set clock" Click="SetClock_Click"/><Button Tag="ClockAdjust" Content="+1 sec" Click="PlusSecond_Click"/></UniformGrid><Button Tag="NextPeriod" Content="Next period" Click="NextPeriod_Click"/></StackPanel></Border><Border x:Name="FootballPanel" Tag="Football" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="AMERICAN FOOTBALL · DOWN &amp; DISTANCE" FontWeight="Bold"/><TextBlock x:Name="DownDisplay" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="4"/><TextBlock x:Name="BallDisplay" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button Content="Next down" Tag="NextDown" Click="NextDown_Click"/><Button Content="Distance −1 yd" Tag="DistanceMinus" Click="DistanceMinus_Click"/><Button Content="Distance +1 yd" Tag="DistancePlus" Click="DistancePlus_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="Ball −5 yd" Tag="BallMinus" Click="BallMinus_Click"/><Button Content="Ball +5 yd" Tag="BallPlus" Click="BallPlus_Click"/><Button Content="New series" Tag="NewSeries" Click="NewSeries_Click"/></UniformGrid><UniformGrid Columns="2"><Button Tag="FootballYards" Content="Home +10 yards"  Click="HomeYards_Click"/><Button Tag="FootballYards" Content="Away +10 yards"  Click="AwayYards_Click"/><Button Tag="Turnover" Content="Home turnover"  Click="HomeTurnover_Click"/><Button Tag="Turnover" Content="Away turnover"  Click="AwayTurnover_Click"/></UniformGrid><TextBlock x:Name="FootballStatsDisplay" HorizontalAlignment="Center" Margin="8"/></StackPanel></Border><Border x:Name="SoccerPanel" Tag="Soccer" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="SOCCER · DISCIPLINE" FontWeight="Bold"/><UniformGrid Columns="2"><Button Tag="SoccerCard" Content="Home yellow card"  Click="HomeYellow_Click"/><Button Tag="SoccerCard" Content="Away yellow card"  Click="AwayYellow_Click"/><Button Tag="SoccerCard" Content="Home red card"  Click="HomeRed_Click"/><Button Tag="SoccerCard" Content="Away red card"  Click="AwayRed_Click"/></UniformGrid><UniformGrid Columns="2"><Button Tag="SoccerShot" Content="Home shot"  Click="HomeShot_Click"/><Button Tag="SoccerShot" Content="Away shot"  Click="AwayShot_Click"/><Button Tag="SoccerCorner" Content="Home corner"  Click="HomeCorner_Click"/><Button Tag="SoccerCorner" Content="Away corner"  Click="AwayCorner_Click"/></UniformGrid><TextBlock x:Name="SoccerStatsDisplay" HorizontalAlignment="Center" Margin="6"/><TextBlock x:Name="CardsDisplay" HorizontalAlignment="Center" FontSize="16" Margin="8"/></StackPanel></Border><Border x:Name="BasketballPanel" Tag="Basketball" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="BASKETBALL · FOULS &amp; SHOT CLOCK" FontWeight="Bold"/><UniformGrid Columns="2"><Button Tag="Foul" Content="Home foul"  Click="HomeFoul_Click"/><Button Tag="Foul" Content="Away foul"  Click="AwayFoul_Click"/></UniformGrid><TextBlock x:Name="BasketballStatsDisplay" HorizontalAlignment="Center" Margin="6"/><UniformGrid Columns="3"><Button Tag="ShotClockToggle" Content="Start/stop"  Click="ShotClockToggle_Click"/><Button Tag="ShotClockReset" Content="Reset 24"  Click="ShotClockReset_Click"/><Button Tag="ShotClockSet" Content="Set shot clock"  Click="ShotClockSet_Click"/></UniformGrid></StackPanel></Border><Border x:Name="BaseballPanel" Tag="Baseball" Background="#171C25" CornerRadius="8" Padding="14" Margin="0,0,0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="BASEBALL · AT-BAT &amp; HITS" FontWeight="Bold"/><TextBlock x:Name="CountDisplay" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="6"/><UniformGrid Columns="3"><Button Tag="BaseballCount" Content="Ball"  Click="BaseballBall_Click"/><Button Tag="BaseballCount" Content="Strike"  Click="BaseballStrike_Click"/><Button Tag="BaseballCount" Content="Foul ball"  Click="BaseballFoul_Click"/></UniformGrid><UniformGrid Columns="3"><Button Tag="BaseballCount" Content="Out"  Click="BaseballOut_Click"/><Button Tag="BaseballHit" Content="Home hit"  Click="HomeHit_Click"/><Button Tag="BaseballHit" Content="Away hit"  Click="AwayHit_Click"/></UniformGrid><TextBlock x:Name="HitsDisplay" HorizontalAlignment="Center" Margin="8"/></StackPanel></Border><Button Tag="Undo" Content="Undo last action  ·  Ctrl+Z" Click="Undo_Click"/></StackPanel></ScrollViewer></DockPanel></Window>