<Window x:Class="Scoreboard.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="480" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI"><StackPanel Margin="22"><TextBlock Text="SETTINGS &amp; PREFERENCES" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/><TextBlock Text="Appearance" Foreground="#93A0B2"/><ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"/><TextBlock Text="Light and dark themes apply to the operator windows. Audience graphics retain their designed colors." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,4,8,16"/><Separator/><TextBlock Text="Operator workflow" FontWeight="Bold" Margin="4,14,4,4"/><CheckBox x:Name="SeparateControls" Content="Open control panel in a separate window" Margin="8" Checked="Controls_Changed" Unchecked="Controls_Changed"/><TextBlock Text="The detached game panel stays synchronized, keeps clock and scoring visible, and explains keyboard shortcuts." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,0,8,16"/><Button Content="Done" HorizontalAlignment="Right" IsDefault="True" Click="Done_Click"/></StackPanel></Window>