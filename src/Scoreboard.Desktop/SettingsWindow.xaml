<Window x:Class="Scoreboard.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScorePlus — Preferences" PreviewKeyDown="Window_PreviewKeyDown" Width="520" SizeToContent="Height" MinHeight="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock Text="Preferences are stored locally." VerticalAlignment="Center" Foreground="#93A0B2" FontSize="11"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Save" IsDefault="True" Click="Save_Click"/>
        <Button Content="Cancel" Click="Done_Click"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="PREFERENCES" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="APPEARANCE" Foreground="#93A0B2" FontSize="11" Margin="4,0,0,2"/>
        <ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"/>
        <TextBlock Text="System follows the Windows app theme (Settings → Personalisation → Colours), so the panels match your desktop. Dark and Light pin one. Applies to operator windows only: scorebug and audience graphics keep their designed colors." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,14"/>
        <Separator/>
        <TextBlock Text="OPERATOR WORKFLOW" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="ShowHints" Content="Show tips next to headings (for example 'scoring, timing, actions')" Checked="Controls_Changed" Unchecked="Controls_Changed"/>
        <TextBlock Text="Off by default. Turning it on adds the small explanatory labels in the header, the media dock and the console cards." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
        <TextBlock Text="Value switch delay" Foreground="#93A0B2" FontSize="11" Margin="4,10,0,2"/>
        <DockPanel Margin="4,0,4,0">
          <TextBlock DockPanel.Dock="Right" Text="seconds · 0 is instant, 5 is the longest" VerticalAlignment="Center"
                     Foreground="#93A0B2" FontSize="11" Margin="8,0,0,0"/>
          <TextBox x:Name="DelayInput" Width="90" MinHeight="30" Padding="8,4" TextChanged="Delay_Changed"
                   ToolTip="Any value from 0 to 5, for example 0.35"/>
        </DockPanel>
        <TextBlock Text="How long every graphic holds an old value before it switches to the new one. Type any value from 0 to 5; 0 prints instantly and is the default." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
        <Separator/>
        <TextBlock Text="GAME SAFETY" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <Button x:Name="DeleteAutosavesButton" Content="Delete all autosaves" HorizontalAlignment="Left" MinHeight="32"
                Padding="14,6" Click="DeleteAutosaves_Click" Margin="4,4,4,2"
                ToolTip="Remove every recoverable point from this computer. Saved .spg games are not touched."/>
        <TextBlock x:Name="AutosaveStatus" Text="Autosave keeps a recovery point every few seconds while you work."
                   TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,2,6,4"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
