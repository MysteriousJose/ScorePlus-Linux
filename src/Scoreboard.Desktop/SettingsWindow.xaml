<Window x:Class="Scoreboard.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" Width="480" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI"><StackPanel Margin="22"><TextBlock Text="SETTINGS &amp; PREFERENCES" FontSize="18" FontWeight="Bold" Margin="0,0,0,18"/><TextBlock Text="Appearance" Foreground="#93A0B2"/><ComboBox x:Name="ThemeSelector" Foreground="#FFF4F7FB" Background="#FF000000" BorderBrush="#FF383838" SelectionChanged="Theme_Changed"><ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" Background="#FF000000" BorderBrush="#FF383838" Foreground="#FFF4F7FB"><Grid><ContentPresenter Margin="8,4,28,4" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#FFF4F7FB" Data="M 0 0 L 4 4 L 8 0 Z"/></Grid></ToggleButton><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#FF050505" BorderBrush="#FF383838" BorderThickness="1"><ScrollViewer MaxHeight="180" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></ComboBox.Template><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FFF4F7FB"/></DataTemplate></ComboBox.ItemTemplate><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FFF4F7FB"/><Setter Property="Background" Value="#FF080808"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#FF303030"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF202020"/></Trigger></Style.Triggers></Style></ComboBox.ItemContainerStyle></ComboBox><TextBlock Text="Light and dark themes apply to the operator windows. Audience graphics retain their designed colors." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,4,8,16"/><Separator/><TextBlock Text="Operator workflow" FontWeight="Bold" Margin="4,14,4,4"/><CheckBox x:Name="SeparateControls" Content="Open control panel in a separate window" Margin="8" Checked="Controls_Changed" Unchecked="Controls_Changed"/><TextBlock Text="The detached game panel stays synchronized, keeps clock and scoring visible, and explains keyboard shortcuts." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,0,8,16"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Save" IsDefault="True" Click="Save_Click"/><Button Content="Cancel" Click="Done_Click"/></StackPanel></StackPanel></Window>