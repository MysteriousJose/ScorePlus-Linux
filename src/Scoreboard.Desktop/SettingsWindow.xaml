<Window x:Class="Scoreboard.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ScorePlus — Preferences" Width="520" SizeToContent="Height" MinHeight="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
      <TextBlock Text="Preferences are stored locally." VerticalAlignment="Center" Foreground="#93A0B2" FontSize="11"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Save" IsDefault="True" Click="Save_Click"/>
        <Button Content="Cancel" Click="Done_Click"/>
      </StackPanel>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="PREFERENCES" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Text="APPEARANCE" Foreground="#93A0B2" FontSize="11" Margin="4,0,0,2"/>
        <ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"/>
        <TextBlock Text="Applies to operator windows only. Scorebug and audience graphics keep their designed colors." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,14"/>
        <Separator/>
        <TextBlock Text="OPERATOR WORKFLOW" Foreground="#93A0B2" FontSize="11" Margin="4,14,0,2"/>
        <CheckBox x:Name="SeparateControls" Content="Open the control panel in its own window" Checked="Controls_Changed" Unchecked="Controls_Changed"/>
        <CheckBox x:Name="ShowHints" Content="Show tips next to headings (for example 'scoring, timing, actions')" Checked="Controls_Changed" Unchecked="Controls_Changed"/>
        <TextBlock Text="Off by default. Turning it on adds the small explanatory labels in the header, the media dock and the console cards." TextWrapping="Wrap" Foreground="#93A0B2" FontSize="11" Margin="6,4,6,8"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
