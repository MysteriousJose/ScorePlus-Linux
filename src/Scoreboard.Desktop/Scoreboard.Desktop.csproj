<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ScorePlus</AssemblyName>
    <RootNamespace>Scoreboard.Desktop</RootNamespace>
    <SelfContained>true</SelfContained>
    <Product>ScorePlus</Product>
    <AssemblyTitle>ScorePlus</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Description>ScorePlus live production scoreboard</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Every window and view is constructed in code with its dependencies and loaded through the
         compiled InitializeComponent path. Avalonia's URI-based runtime XAML loader is not used, so
         AVLN3001's parameterless-constructor requirement does not apply to this app. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Only the program itself lands in the release folder: no NuGet XML docs beside it. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Scoreboard.Core/Scoreboard.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <!-- The headless UI harness checks the fit arithmetic and simulates a small work area. -->
    <InternalsVisibleTo Include="UiSmoke" />
  </ItemGroup>
  <ItemGroup Label="Avalonia embedded media, reached by avares:// URIs (logo, scorebug art)">
    <!-- The .axaml surfaces need no listing: Avalonia's targets glob **/*.axaml as AvaloniaXaml
         and compile them. WPF-era <Resource> items did nothing here, so they are gone. -->
    <AvaloniaResource Include="Assets/*.png" />
    <Content Include="Assets/*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window markup says Icon="app.ico". Avalonia only sees what is registered here, which is
         why the WPF-era ApplicationIcon alone left every window throwing on load. -->
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- No Windows-only packages: HTML is captured with headless system Chromium/Chrome, and
         media/audio/camera go through ffmpeg and PulseAudio. Keeping WPF's WebView2 here would
         drag Windows assemblies into every macOS/Linux build. -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
</Project>
