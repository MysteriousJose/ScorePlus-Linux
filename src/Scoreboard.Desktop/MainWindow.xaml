<Window x:Class="Scoreboard.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Scoreboard.Desktop" Title="ScorePlus | Live Production" Width="1520" Height="980" MinWidth="1040" MinHeight="760" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="RailCard" TargetType="Border">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="RailTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RailAccent" TargetType="Border">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="#38D7A3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="SplitterStyle" TargetType="GridSplitter">
      <Setter Property="Background" Value="#1E2630"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <!-- The two halves of the operator surface: the console, and the media desk. -->
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#141A23"/>
      <Setter Property="BorderBrush" Value="#28323F"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
    </Style>
  </Window.Resources>

  <DockPanel x:Name="Root">
    <Border DockPanel.Dock="Top" Background="#171C25" Padding="14,7">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource HeaderButton}" Content="New Panel" Click="NewPanel_Click" ToolTip="Open a detached control panel that stays in sync"/>
          <Button Style="{StaticResource HeaderButton}" Content="Keybinds…" Click="Keybinds_Click" ToolTip="Assign a key combination to any control"/>
          <Button Style="{StaticResource HeaderButton}" Content="Preferences" Click="Preferences_Click"/>
          <Button Style="{StaticResource HeaderButton}" Content="Audience Output" Click="Output_Click" ToolTip="Choose a display and open its audience window (F11 fills the screen)"/>
          <Button Style="{StaticResource HeaderButton}" Content="Event Log" Click="EventLog_Click" ToolTip="Open the event log in its own window"/>
          <Button Style="{StaticResource HeaderButton}" Content="Game Report" Click="GameReport_Click"/>
          <Button Style="{StaticResource HeaderButton}" Content="Save Game" Click="Save_Click"/>
          <Button Style="{StaticResource HeaderButton}" Content="Open Game" Click="Open_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="●" Foreground="#38D7A3" FontSize="18" Margin="3,0,9,0"/>
          <TextBlock Text="SCOREPLUS" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="  /  LIVE PRODUCTION" Foreground="#93A0B2" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#12171F" Padding="14,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource HeaderButton}" Content="Scorebug Studio" Click="ScorebugStudio_Click"/>
          <Button Style="{StaticResource HeaderButton}" Content="Sport Profiles" Click="SportProfiles_Click"/>
          <Button Style="{StaticResource HeaderButton}" Content="New Game" Click="NewGame_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="SPORT" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
          <ComboBox x:Name="SportSelector" Width="220" SelectionChanged="Sport_Changed">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="SportHint" Text="Everything you need for the game is on this page." Foreground="#5C6B7E" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" Visibility="Collapsed"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#171C25" Foreground="#93A0B2"><StatusBarItem><TextBlock x:Name="StatusText" Text="READY · Local autosave enabled"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="AutosaveText" Text="Autosave —"/></StatusBarItem></StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="336" MinWidth="260"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*" MinWidth="620"/>
      </Grid.ColumnDefinitions>

      <!-- Left rail: the program preview, with the display it belongs to above the thumbnail. -->
      <Border Grid.Column="0" Style="{StaticResource RailCard}" Margin="0,0,6,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="PreviewAudienceHint" DockPanel.Dock="Right" Text="AUDIENCE" Foreground="#38D7A3" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource RailAccent}"/>
              <TextBlock Text="PROGRAM PREVIEW" Style="{StaticResource RailTitle}"/>
            </StackPanel>
          </DockPanel>

          <!-- Which display this preview is looking at. Each window keeps its own choice. -->
          <DockPanel Grid.Row="1" Margin="0,0,0,5">
            <TextBlock Text="DISPLAY" DockPanel.Dock="Left" Foreground="#5C6B7E" FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="DisplaySelector" FontSize="11" MinHeight="28" SelectionChanged="Display_Changed"
                      ToolTip="Choose the display this preview shows. Each window picks its own."/>
          </DockPanel>

          <!-- Several layouts can live on one display; the arrows choose what Update Output sends out. -->
          <DockPanel Grid.Row="2" Margin="0,0,0,5">
            <Button x:Name="LayoutPrevButton" DockPanel.Dock="Left" Content="◀" Padding="0" Width="34" MinHeight="30"
                    FontSize="12" Click="LayoutPrev_Click" ToolTip="Previous layout on this display"/>
            <Button x:Name="LayoutNextButton" DockPanel.Dock="Right" Content="▶" Padding="0" Width="34" MinHeight="30"
                    FontSize="12" Click="LayoutNext_Click" ToolTip="Next layout on this display"/>
            <TextBlock x:Name="PreviewLayoutLabel" Text="1 · Broadcast Classic" FontSize="11" FontWeight="SemiBold"
                       TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
          </DockPanel>

          <ContentControl x:Name="PreviewHost" Grid.Row="3" VerticalAlignment="Top"/>

          <!-- What the audience is actually watching: the published layout, on a display of
               its own choice, smaller than the staged preview above it. -->
          <Border Grid.Row="4" Background="#171C25" CornerRadius="9" Padding="10,8" Margin="0,8,0,0" Height="190">
            <ContentControl x:Name="AudienceHost"/>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

      <!-- Operator surface: the console on one tab, the whole media desk on the other. -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ControlTab" Style="{StaticResource TabButton}" Content="CONTROL PANEL" Click="ControlTab_Click"/>
          <Button x:Name="MediaTab" Style="{StaticResource TabButton}" Content="MEDIA" Click="MediaTab_Click" ToolTip="Clips, camera, replay and playlists"/>
          <Button x:Name="RosterTab" Style="{StaticResource TabButton}" Content="ROSTERS" Click="RosterTab_Click"
                  ToolTip="Team rosters, player stats and the player on the graphic"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <ContentControl x:Name="ControlHost"/>
          <local:MediaDock x:Name="MediaControl" Visibility="Collapsed"/>
          <local:RosterDock x:Name="RosterControl" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
