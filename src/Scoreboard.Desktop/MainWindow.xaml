<Window x:Class="Scoreboard.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scoreboard | Live Production" Width="1440" Height="900" MinWidth="900" MinHeight="620" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI" KeyDown="Window_KeyDown">
<DockPanel>
  <Border DockPanel.Dock="Top" Background="#171C25" Padding="14,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Preferences" Click="Preferences_Click"/><Button Content="Control Panel" Click="ControlPanel_Click"/><Button Content="Audience Output" Click="Output_Click"/><Button Content="Broadcast Fullscreen" Click="Fullscreen_Click"/><Button Content="Game Report" Click="GameReport_Click"/><Button Content="Save Game" Click="Save_Click"/><Button Content="Open Game" Click="Open_Click"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#38D7A3" FontSize="18" Margin="3,0,9,0"/><TextBlock Text="SCOREBOARD" FontSize="17" FontWeight="Bold"/><TextBlock Text="  /  LIVE PRODUCTION" Foreground="#93A0B2" FontSize="13" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#171C25" Foreground="#93A0B2"><StatusBarItem><TextBlock x:Name="StatusText" Text="READY · Local autosave enabled"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="AutosaveText" Text="Autosave —"/></StatusBarItem></StatusBar>
  <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
    <Border Background="#171C25" CornerRadius="8" Padding="12" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Scorebug Studio" Click="ScorebugStudio_Click"/><Button Content="Sport Profiles" Click="SportProfiles_Click"/><Button Content="New Game" Click="NewGame_Click"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SPORT" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="SportSelector" Width="220" Foreground="#FFF4F7FB" Background="#FF000000" BorderBrush="#FF383838" SelectionChanged="Sport_Changed"><ComboBox.Template><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" Background="#FF000000" BorderBrush="#FF383838" Foreground="#FFF4F7FB"><Grid><ContentPresenter Margin="8,4,28,4" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Fill="#FFF4F7FB" Data="M 0 0 L 4 4 L 8 0 Z"/></Grid></ToggleButton><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#FF050505" BorderBrush="#FF383838" BorderThickness="1"><ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></ComboBox.Template><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="#FFF4F7FB"/></DataTemplate></ComboBox.ItemTemplate><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FFF4F7FB"/><Setter Property="Background" Value="#FF080808"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#FF303030"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF202020"/></Trigger></Style.Triggers></Style></ComboBox.ItemContainerStyle></ComboBox><TextBlock Text="   Choose a sport, then open the Control Panel to operate the game." Foreground="#93A0B2" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="#171C25" CornerRadius="10" Padding="16" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,12"><TextBlock Text="PROGRAM PREVIEW" FontSize="13" FontWeight="Bold"/><TextBlock Text="   Audience output" Foreground="#38D7A3" FontSize="12" VerticalAlignment="Center"/></StackPanel><ContentControl x:Name="PreviewHost"/></DockPanel></Border>
    <Border Grid.Row="2" Background="#171C25" CornerRadius="10" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="EVENT LOG" FontWeight="Bold"/><TextBlock Text="   Scoring, timing, and operator actions" Foreground="#93A0B2" Margin="8,0,0,0"/></StackPanel><ListBox x:Name="EventList" Background="#10151D" Foreground="#D6DCE5" BorderThickness="0" FontFamily="Consolas" FontSize="12"/></DockPanel></Border>
  </Grid>
</DockPanel></Window>