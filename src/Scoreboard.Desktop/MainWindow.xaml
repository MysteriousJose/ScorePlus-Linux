<Window x:Class="Scoreboard.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scoreboard | Live Production" Width="1440" Height="900" MinWidth="1050" MinHeight="680" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI" KeyDown="Window_KeyDown">
<DockPanel>
  <Border DockPanel.Dock="Top" Background="#171C25" Padding="14,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Preferences" Click="Preferences_Click"/><Button Content="Control Panel" Click="ControlPanel_Click"/><Button Content="Audience Output" Click="Output_Click"/><Button Content="Broadcast Fullscreen" Click="Fullscreen_Click"/><Button Content="Save Game" Click="Save_Click"/><Button Content="Open Game" Click="Open_Click"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#38D7A3" FontSize="18" Margin="3,0,9,0"/><TextBlock Text="SCOREBOARD" FontSize="17" FontWeight="Bold"/><TextBlock Text="  /  LIVE PRODUCTION" Foreground="#93A0B2" FontSize="13" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#171C25" Foreground="#93A0B2"><StatusBarItem><TextBlock x:Name="StatusText" Text="READY · Local autosave enabled"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="AutosaveText" Text="Autosave —"/></StatusBarItem><StatusBarItem HorizontalAlignment="Right"><TextBlock Text="SPACE Clock  ·  Ctrl+Z Undo  ·  ←/→ Score"/></StatusBarItem></StatusBar>
  <Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="200"/></Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="#171C25" CornerRadius="8" Padding="12" Margin="0,0,0,12"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SPORT" Foreground="#93A0B2" VerticalAlignment="Center"/><ComboBox x:Name="SportSelector" Width="180" SelectionChanged="Sport_Changed"/><Button Content="Scorebug Studio" Click="ScorebugStudio_Click"/><Button Content="Sport Profiles" Click="SportProfiles_Click"/><Button Content="New Game" Click="NewGame_Click"/><Button Content="↶ Undo" Click="Undo_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="GAME CONTROL" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="   Live state is saved locally" Foreground="#93A0B2" VerticalAlignment="Center"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Background="#171C25" CornerRadius="10" Padding="16" Margin="0,0,10,10"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,12"><TextBlock Text="PROGRAM PREVIEW" FontSize="13" FontWeight="Bold"/><TextBlock Text="   LIVE · audience output" Foreground="#38D7A3" FontSize="12" VerticalAlignment="Center"/></StackPanel><ContentControl x:Name="PreviewHost"/></DockPanel></Border>
    <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Border Background="#171C25" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="TEAMS" FontWeight="Bold" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="HomeName" Text="HOME"/><TextBox x:Name="AwayName" Grid.Column="1" Text="VISITORS"/></Grid><Button Content="Apply team names" Click="Teams_Click" HorizontalAlignment="Right"/></StackPanel></Border>
      <Border Background="#171C25" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><DockPanel><TextBlock Text="SCORING · tap a score to correct it" FontWeight="Bold"/><TextBlock Text="tap score to correct" Foreground="#93A0B2" DockPanel.Dock="Right"/></DockPanel><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="HomeScore" FontSize="42" FontWeight="Bold" Foreground="#38D7A3" HorizontalAlignment="Center" MouseLeftButtonDown="ScoreEdit_Click"/><TextBlock x:Name="AwayScore" Grid.Column="1" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" MouseLeftButtonDown="ScoreEdit_Click"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><UniformGrid Columns="3"><Button Content="+1" Tag="1" Click="HomeScore_Click"/><Button Content="+2" Tag="2" Click="HomeScore_Click"/><Button Content="+3" Tag="3" Click="HomeScore_Click"/></UniformGrid><UniformGrid Columns="2"><Button Content="−1" Tag="-1" Click="HomeScore_Click"/><Button Content="Timeout" Click="HomeTimeout_Click"/></UniformGrid></StackPanel><StackPanel Grid.Column="1"><UniformGrid Columns="3"><Button Content="+1" Tag="1" Click="AwayScore_Click"/><Button Content="+2" Tag="2" Click="AwayScore_Click"/><Button Content="+3" Tag="3" Click="AwayScore_Click"/></UniformGrid><UniformGrid Columns="2"><Button Content="−1" Tag="-1" Click="AwayScore_Click"/><Button Content="Timeout" Click="AwayTimeout_Click"/></UniformGrid></StackPanel></Grid><Button Content="↔  Toggle possession" Click="Possession_Click" HorizontalAlignment="Stretch"/></StackPanel></Border>
      <Border Background="#171C25" CornerRadius="10" Padding="14"><StackPanel><DockPanel><TextBlock Text="GAME CLOCK · Space starts/stops" FontWeight="Bold"/><TextBlock x:Name="PeriodText" Text="PERIOD 1" Foreground="#93A0B2" DockPanel.Dock="Right"/></DockPanel><TextBlock x:Name="ClockText" Text="12:00" FontFamily="Consolas" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/><UniformGrid Columns="3"><Button x:Name="ClockButton" Content="▶  START" Click="Clock_Click"/><Button Content="−1:00" Click="MinusMinute_Click"/><Button Content="+1:00" Click="PlusMinute_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="−1 sec" Click="MinusSecond_Click"/><Button Content="Set time" Click="SetClock_Click"/><Button Content="+1 sec" Click="PlusSecond_Click"/></UniformGrid><Button Content="Next period  →" Click="NextPeriod_Click" HorizontalAlignment="Stretch"/><TextBlock Text="EVENT CLOCK · monotonic timing" Foreground="#93A0B2" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border>
      <Border x:Name="FootballPanel" Background="#171C25" CornerRadius="10" Padding="14" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="AMERICAN FOOTBALL · DOWN &amp; DISTANCE" FontWeight="Bold"/><TextBlock x:Name="DownDisplay" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="4"/><TextBlock x:Name="BallDisplay" HorizontalAlignment="Center"/><UniformGrid Columns="3"><Button Content="Next down" Click="NextDown_Click"/><Button Content="−1 yd to go" Click="DistanceMinus_Click"/><Button Content="+1 yd to go" Click="DistancePlus_Click"/></UniformGrid><UniformGrid Columns="3"><Button Content="Ball −5 yd" Click="BallMinus_Click"/><Button Content="Ball +5 yd" Click="BallPlus_Click"/><Button Content="New series" Click="NewSeries_Click"/></UniformGrid></StackPanel></Border>
      <Border x:Name="SoccerPanel" Background="#171C25" CornerRadius="10" Padding="14" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="SOCCER · CARDS" FontWeight="Bold"/><UniformGrid Columns="2"><Button Content="Home yellow" Click="HomeYellow_Click"/><Button Content="Away yellow" Click="AwayYellow_Click"/><Button Content="Home red" Click="HomeRed_Click"/><Button Content="Away red" Click="AwayRed_Click"/></UniformGrid><TextBlock x:Name="CardsDisplay" HorizontalAlignment="Center" Margin="8"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#171C25" CornerRadius="10" Padding="14" Margin="0,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="EVENT LOG" FontWeight="Bold"/><TextBlock Text="   Scoring, timing, and operator actions" Foreground="#93A0B2" Margin="8,0,0,0"/></StackPanel><ListBox x:Name="EventList" Background="#10151D" Foreground="#D6DCE5" BorderThickness="0" FontFamily="Consolas" FontSize="12"/></DockPanel></Border>
  </Grid>
</DockPanel></Window>
