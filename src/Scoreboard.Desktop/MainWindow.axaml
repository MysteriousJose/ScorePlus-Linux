<Window x:Class="Scoreboard.Desktop.MainWindow" Icon="app.ico" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Scoreboard.Desktop" Title="ScorePlus | Live Production" Width="1520" Height="980" MinWidth="900" MinHeight="600" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <!-- Icon-only header actions: the tooltip carries the name, the glyph keeps the bar calm. -->
    
    
    <!-- The two halves of the operator surface: the console, and the media desk. -->
  
</Window.Resources>
  <Window.Styles>
    <Style Selector="Button.header-button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style Selector="Button.header-button.icon-button">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <!-- The header strips shrink their own padding one step at the compact tier, so the wrapped
         rows give the buttons the width they need instead of eating it. -->
    <Style Selector="Border.top-header">
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style Selector="Border.sub-header">
      <Setter Property="Padding" Value="14,6"/>
    </Style>
    <Style Selector="DockPanel.narrow Border.top-header">
      <Setter Property="Padding" Value="7,4"/>
    </Style>
    <Style Selector="DockPanel.narrow Border.sub-header">
      <Setter Property="Padding" Value="7,4"/>
    </Style>
    <!-- The overflow menus are part of the operator chrome, not the system menu bar. -->
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinWidth" Value="200"/>
    </Style>
    <Style Selector="Border.rail-card">
      <Setter Property="Background" Value="#171C25"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBlock.rail-title">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.rail-accent">
      <Setter Property="Width" Value="3"/>
      <Setter Property="Height" Value="12"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="#38D7A3"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style Selector="GridSplitter.splitter-style">
      <Setter Property="Background" Value="#1E2630"/>
      <Setter Property="ShowsPreview" Value="True"/>
    </Style>
    <Style Selector="Button.tab-button">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="#141A23"/>
      <Setter Property="BorderBrush" Value="#28323F"/>
      <Setter Property="Foreground" Value="#93A0B2"/>
    </Style>
</Window.Styles>

  <Grid>
  <DockPanel x:Name="Root">
    <!-- Row one: the brand, the few actions a show cannot run without, and a "more" menu. Every
         button lives in a WrapPanel inside a star column, so a narrow window wraps the row instead
         of drawing the buttons over the brand. -->
    <Border x:Name="TopBar" Classes="top-header" DockPanel.Dock="Top" Background="#171C25">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#0E1218" CornerRadius="7" Padding="6,4" Margin="0,0,10,0" VerticalAlignment="Center">
            <Image Source="Assets/logo.png" Height="26" Stretch="Uniform"
                   VerticalAlignment="Center" ToolTip.Tip="ScorePlus"/>
          </Border>
          <TextBlock Text="SCOREPLUS" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="RailToggleButton" Classes="header-button icon-button" Content="◧" IsVisible="False"
                  Click="RailToggle_Click" ToolTip.Tip="Show or hide the program preview rail"/>
          <Button x:Name="LockButton" Classes="header-button icon-button" Content="🔒" Click="Lock_Click" ToolTip.Tip="Lock ScorePlus — console, media, rosters and the remote stay locked until the password is entered"/>
          <Button Classes="header-button icon-button" Content="⧉" Click="NewPanel_Click" ToolTip.Tip="New panel — open a detached control panel that stays in sync"/>
          <Button Classes="header-button icon-button" Content="▶" Click="Output_Click" ToolTip.Tip="Audience output — choose a display and open its window (F11 fills the screen)"/>
          <Button Classes="header-button icon-button" Content="✍" Click="Annotate_Click" ToolTip.Tip="Draw on the audience picture — pen, highlighter and eraser over the live graphic (T on the output window)"/>
          <Button Classes="header-button icon-button" Content="☰" Click="EventLog_Click" ToolTip.Tip="Event log — open it in its own window"/>
          <Button Classes="header-button" Content="Save Game" Click="Save_Click"/>
          <Button Classes="header-button" Content="Open Game" Click="Open_Click"/>
          <Button Classes="header-button icon-button" Content="⋯" ToolTip.Tip="More tools">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Keybinds…" Click="Keybinds_Click"/>
                <MenuItem Header="Preferences…" Click="Preferences_Click"/>
                <MenuItem Header="About ScorePlus" Click="Info_Click"/>
                <MenuItem Header="Game report…" Click="GameReport_Click"/>
                <MenuItem Header="Ad log…" Click="AdLog_Click"/>
                <MenuItem Header="Hardware…" Click="Hardware_Click"/>
                <MenuItem Header="Conditionals…" Click="Automation_Click"/>
                <MenuItem Header="Icon creator…" Click="IconMaker_Click"/>
                <MenuItem Header="League cloud…" Click="LeagueCloud_Click"/>
                <MenuItem Header="Ticker rotation…" Click="Ticker_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Row two: the show fields on the left, the setup actions on the right. The actions wrap
         inside the star column; the sport picker can shrink to its minimum and the game name box
         keeps a usable floor without pinning the row to one width. -->
    <Border x:Name="SecondBar" Classes="sub-header" DockPanel.Dock="Top" Background="#12171F">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="SPORT" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
          <ComboBox x:Name="SportSelector" MinWidth="140" MaxWidth="220" SelectionChanged="Sport_Changed">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Text="GAME" Foreground="#93A0B2" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
            <TextBox x:Name="GameNameBox" MinWidth="100" Width="150" MaxWidth="220" MinHeight="32" Padding="8,4" FontSize="12"
                     MaxLength="120" VerticalContentAlignment="Center" TextChanged="GameName_Changed"
                     ToolTip.Tip="Name this game; it is saved with the game and shown in autosaves, reports and league cloud uploads"/>
          </StackPanel>
          <TextBlock x:Name="SportHint" Text="Everything you need for the game is on this page." Foreground="#5C6B7E" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" IsVisible="False"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Classes="header-button" Content="Multiview" Click="Multiview_Click" ToolTip.Tip="Every camera at once, with the replay preview beside the live picture"/>
          <Button Classes="header-button" Content="Replay Booth" Click="ReplayBooth_Click" ToolTip.Tip="Review the last replay window of every camera with the clocks that were showing"/>
          <Button Classes="header-button" Content="Display Studio" Click="ScorebugStudio_Click"/>
          <Button Classes="header-button" Content="New Game" Click="NewGame_Click"/>
          <Button x:Name="EndGameButton" Classes="header-button" Content="End Game" Click="EndGame_Click" ToolTip.Tip="Stop every clock, mark the game final and add the result to each team's record"/>
          <Button Classes="header-button icon-button" Content="⋯" ToolTip.Tip="More setup tools">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Transition Maker…" Click="TransitionMaker_Click"/>
                <MenuItem Header="Animation Maker…" Click="AnimationMaker_Click"/>
                <MenuItem Header="Sport Profiles…" Click="SportProfiles_Click"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- No StatusBar control in the Avalonia world: a plain bordered strip with the same
         items, so StatusText/AutosaveText keep their names for the C# status writers. -->
    <Border DockPanel.Dock="Bottom" Background="#171C25" Padding="10,6">
      <DockPanel>
        <TextBlock x:Name="StatusText" Text="READY · Local autosave enabled" Foreground="#93A0B2" VerticalAlignment="Center"/>
        <TextBlock Text="·" Foreground="#93A0B2" VerticalAlignment="Center" Margin="10,0"/>
        <TextBlock x:Name="AutosaveText" Text="Autosave —" DockPanel.Dock="Right" Foreground="#93A0B2" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Last-resort fallback: a short window scrolls the whole workspace instead of clipping the
         bottom of the console. The code-behind turns scrolling off at normal heights, where the
         star rows must keep filling the window. -->
    <ScrollViewer x:Name="WorkspaceScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
      <Grid x:Name="Workspace" Margin="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="336" MinWidth="260"/>
          <ColumnDefinition Width="7"/>
          <ColumnDefinition Width="*" MinWidth="620"/>
        </Grid.ColumnDefinitions>

        <!-- Left rail: the program preview, with the display it belongs to above the thumbnail.
             It scrolls in place when the window is short, so no card goes out of reach. -->
        <Border x:Name="RailHost" Classes="rail-card" Grid.Column="0" Margin="0,0,6,0">
          <ScrollViewer x:Name="RailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="RailBody">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="PreviewAudienceHint" DockPanel.Dock="Right" Text="AUDIENCE" Foreground="#38D7A3" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" IsVisible="False"/>
                <StackPanel Orientation="Horizontal">
                  <Border Classes="rail-accent"/>
                  <TextBlock Text="PROGRAM PREVIEW" Classes="rail-title"/>
                </StackPanel>
              </DockPanel>

              <!-- Which display this preview is looking at. Each window keeps its own choice. -->
              <DockPanel Grid.Row="1" Margin="0,0,0,5">
                <TextBlock Text="DISPLAY" DockPanel.Dock="Left" Foreground="#5C6B7E" FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="DisplaySelector" FontSize="11" MinHeight="28" SelectionChanged="Display_Changed"
                          ToolTip.Tip="Choose the display this preview shows. Each window picks its own."/>
              </DockPanel>

              <!-- Several layouts can live on one display; the arrows choose what Update Output sends out. -->
              <DockPanel Grid.Row="2" Margin="0,0,0,5">
                <Button x:Name="LayoutPrevButton" DockPanel.Dock="Left" Content="◀" Padding="0" Width="34" MinHeight="30"
                        FontSize="12" Click="LayoutPrev_Click" ToolTip.Tip="Previous layout on this display"/>
                <Button x:Name="LayoutNextButton" DockPanel.Dock="Right" Content="▶" Padding="0" Width="34" MinHeight="30"
                        FontSize="12" Click="LayoutNext_Click" ToolTip.Tip="Next layout on this display"/>
                <TextBlock x:Name="PreviewLayoutLabel" Text="1 · Broadcast Classic" FontSize="11" FontWeight="SemiBold"
                           TextAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
              </DockPanel>

              <!-- A preferred height with a floor: inside the rail's scroller the preview sizes to
                   its maximum on a tall window and stays readable on a short one. -->
              <ContentControl x:Name="PreviewHost" Grid.Row="3" VerticalAlignment="Top" MinHeight="110" MaxHeight="340"/>

              <!-- Four assignable quick-layout buttons, directly above the meter. A press stages a
                   layout on any display; Preferences can also make it update output. -->
              <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <ContentControl x:Name="QuickMediaHost"/>
                <ContentControl x:Name="QuickLayoutsHost"/>
              </StackPanel>

              <!-- What the machine is putting out, and where the show stands: the peak level the room
                   hears, with the on-air display and layout beside it. -->
              <Border Grid.Row="5" Background="#171C25" CornerRadius="9" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                      <TextBlock x:Name="SoundLevelText" DockPanel.Dock="Right" Text="—" Foreground="#93A0B2"
                                 FontSize="10" FontWeight="Bold" Margin="6,0,0,0"/>
                      <TextBlock Text="SOUND LEVEL" Foreground="#5C6B7E" FontSize="10" FontWeight="Bold"/>
                    </DockPanel>
                    <UniformGrid x:Name="SoundMeterSegments" Columns="22" Height="14" Margin="0,5,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="132">
                    <TextBlock x:Name="OnAirInfo" Text="STANDBY" Foreground="#38D7A3" FontSize="10" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ShowInfo" Text="—" Foreground="#93A0B2" FontSize="10" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- What the audience is actually watching: the published layout, on a display of
                   its own choice, smaller than the staged preview above it. -->
              <Border Grid.Row="6" Background="#171C25" CornerRadius="9" Padding="10,8" Margin="0,8,0,0" Height="190">
                <ContentControl x:Name="AudienceHost"/>
              </Border>
            </Grid>
          </ScrollViewer>
        </Border>

        <GridSplitter x:Name="RailSplitter" Classes="splitter-style" Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <!-- Operator surface: the console on one tab, the whole media desk on the other. -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ControlTab" Classes="tab-button" Content="CONTROL PANEL" Click="ControlTab_Click"/>
            <Button x:Name="MediaTab" Classes="tab-button" Content="MEDIA" Click="MediaTab_Click" ToolTip.Tip="Clips, camera, replay and playlists"/>
            <Button x:Name="RosterTab" Classes="tab-button" Content="ROSTERS" Click="RosterTab_Click"
                    ToolTip.Tip="Team rosters, player stats and the player on the graphic"/>
            <Button x:Name="MacrosTab" Classes="tab-button" Content="MACROS" Click="MacrosTab_Click"
                    ToolTip.Tip="One button that changes several things in order"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <ContentControl x:Name="ControlHost"/>
            <local:MediaDock x:Name="MediaControl" IsVisible="False"/>
            <local:RosterDock x:Name="RosterControl" IsVisible="False"/>
            <ContentControl x:Name="MacroHost" IsVisible="False"/>
          </Grid>
        </Grid>
      </Grid>
    </ScrollViewer>
  </DockPanel>

  <!-- Covers the whole operator window while the desk is locked. It sits outside Root so the
       password box stays usable while everything behind it is disabled. -->
  <Border x:Name="LockOverlay" IsVisible="False" Background="#F20B0F15">
    <Border Width="400" Padding="26,22" CornerRadius="14" Background="#171C25" BorderBrush="#2E3B4A" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="🔒" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="SCOREPLUS LOCKED" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="The console, media, rosters, control panels and the phone remote are locked. Enter the operator lock password to continue."
                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#93A0B2" FontSize="11" Margin="4,8,4,14"/>
        <TextBox x:Name="UnlockPasswordInput" PasswordChar="●" MinHeight="38" Padding="10,6" Background="#050505"
                 Foreground="#F4F7FB" BorderBrush="#383838" KeyDown="UnlockPassword_KeyDown"/>
        <Button Content="Unlock" Click="Unlock_Click" IsDefault="True" Margin="0,10,0,0" MinHeight="40"/>
        <TextBlock x:Name="UnlockError" Foreground="#FF7272" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="4,8,4,0"/>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
