<Window x:Class="Scoreboard.Desktop.PreferencesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preferences" Width="470" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#171C25" Foreground="#F4F7FB" FontFamily="Segoe UI"><StackPanel Margin="20"><TextBlock Text="PREFERENCES" FontWeight="Bold" FontSize="18" Margin="2,0,0,12"/><TextBlock Text="Appearance" Foreground="#93A0B2"/><ComboBox x:Name="ThemeSelector" SelectionChanged="Theme_Changed"/><TextBlock Text="Choose a high-contrast theme for your game-day environment." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,0,0,16"/><Separator/><TextBlock Text="Control panel" FontWeight="Bold" Margin="4,14,4,6"/><CheckBox x:Name="SeparateControls" Content="Open the dedicated control panel in its own window" Margin="8" Checked="Controls_Changed" Unchecked="Controls_Changed"/><TextBlock Text="The detached panel stays synchronized with this game and is designed for quick, clearly labeled operation." TextWrapping="Wrap" Foreground="#93A0B2" Margin="8,0,8,14"/><Button Content="Done" HorizontalAlignment="Right" IsDefault="True" Click="Done_Click"/></StackPanel></Window>