<Window x:Class="Scoreboard.Desktop.ScorebugEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scorebug Studio" Width="1260" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.ColumnSpan="3" Margin="2,0,2,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add text" Click="AddText_Click"/><Button Content="Add logo" Click="AddLogo_Click"/><Button Content="Add shape" Click="AddShape_Click"/><Button Content="Add sport data" Click="AddData_Click"/><Button Content="Remove" Click="Remove_Click"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="SCOREBUG STUDIO" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="   Arrange audience graphics · edits save automatically" Foreground="#93A0B2" VerticalAlignment="Center"/></StackPanel></DockPanel><DockPanel Grid.Row="1" Background="#171C25" Margin="0,0,10,0"><TextBlock DockPanel.Dock="Top" Text="LAYERS · drag a layer to position it" FontWeight="Bold" Margin="10"/><ListBox x:Name="Layers" Background="#10151D" Foreground="White" BorderBrush="#364151" SelectionChanged="Layers_SelectionChanged" PreviewMouseLeftButtonDown="Layers_MouseDown" PreviewMouseMove="Layers_MouseMove" AllowDrop="True" Drop="Layers_Drop"/></DockPanel><Border Grid.Row="1" Grid.Column="1" Background="#171C25" Padding="12" Margin="0,0,10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="1280 × 720 · drag elements to reposition · bindings update live" Foreground="#93A0B2" Margin="4,0,0,10"/><Border Grid.Row="1" x:Name="CanvasFrame" Background="#091018" ClipToBounds="True" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"><Canvas x:Name="DesignCanvas" Width="1280" Height="720" Background="#091018" RenderTransformOrigin="0,0"><Canvas.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="0.55" ScaleY="0.55"/></Canvas.LayoutTransform></Canvas></Border></Grid></Border><ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Background="#171C25" Margin="0" ><TextBlock Text="ELEMENT PROPERTIES" FontWeight="Bold" Margin="12,12,12,8"/><TextBlock Text="Name" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="NameInput" TextChanged="Property_Changed"/><TextBlock Text="Text / data binding" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="ContentInput" TextChanged="Property_Changed"/><TextBlock Text="X position" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="XInput" TextChanged="Property_Changed"/><TextBlock Text="Y position" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="YInput" TextChanged="Property_Changed"/><TextBlock Text="Width" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="WidthInput" TextChanged="Property_Changed"/><TextBlock Text="Height" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="HeightInput" TextChanged="Property_Changed"/><TextBlock Text="Font size" Foreground="#93A0B2" Margin="8,0,0,0"/><TextBox x:Name="FontInput" TextChanged="Property_Changed"/><TextBlock Text="Text color" Foreground="#93A0B2" Margin="8,0,0,0"/><DockPanel><TextBox x:Name="ColorInput" TextChanged="Property_Changed"/><Button Content="Choose…" Click="TextColor_Click" ToolTip="Open the color palette"/></DockPanel><TextBlock Text="Background color" Foreground="#93A0B2" Margin="8,0,0,0"/><DockPanel><TextBox x:Name="BackgroundInput" TextChanged="Property_Changed"/><Button Content="Choose…" Click="BackgroundColor_Click" ToolTip="Open the color palette"/></DockPanel><CheckBox x:Name="TransparentBackgroundInput" Content="No text background (transparent)" Margin="10" Checked="Property_Changed" Unchecked="Property_Changed"/><TextBlock Text="Animation" Foreground="#93A0B2" Margin="8,0,0,0"/><ComboBox x:Name="AnimationInput" SelectionChanged="Property_Changed"/><CheckBox x:Name="VisibleInput" Content="Visible on output" Margin="10" Checked="Property_Changed" Unchecked="Property_Changed"/><Button Content="Choose logo image…" Click="ChooseImage_Click" HorizontalAlignment="Stretch"/><TextBlock x:Name="ImagePathText" Foreground="#93A0B2" TextWrapping="Wrap" Margin="8"/><Button Content="Zoom to fit" Click="Fit_Click"/><TextBlock Text="Resize: select an element, then drag a blue corner handle on the canvas." Foreground="#93A0B2" TextWrapping="Wrap" Margin="8"/></StackPanel></ScrollViewer><DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Text="Drag and reorder layers. Text supports {{HOME_SCORE}}, {{AWAY_SCORE}}, {{HOME_TEAM}}, {{AWAY_TEAM}}, {{PERIOD}}, {{GAME_CLOCK}}, {{DOWNS}}, {{YARDS}}, {{BALL_SPOT}}, {{TURNOVERS}}, {{FOULS}}, {{SHOT_CLOCK}}, {{BASEBALL_COUNT}}, {{HITS}}, {{CARDS}}, {{SHOTS}}, {{CORNERS}}." Foreground="#93A0B2" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Done" IsDefault="True" Click="Done_Click"/></DockPanel></Grid></Window>