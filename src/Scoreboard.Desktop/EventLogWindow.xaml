<Window x:Class="Scoreboard.Desktop.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScorePlus — Event Log" Width="560" Height="620" MinWidth="380" MinHeight="320"
        Background="#0E1218" Foreground="#F4F7FB" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
      <Button DockPanel.Dock="Right" Content="Clear view" FontSize="11" Padding="8,5" Click="Clear_Click" ToolTip="Clear this window's list only — the game history is untouched"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#38D7A3" FontSize="16" Margin="0,0,8,0"/>
        <TextBlock Text="EVENT LOG" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock x:Name="LogHint" Text="   scoring, timing, actions" Foreground="#5C6B7E" FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>
    </DockPanel>
    <Border Background="#10151D" CornerRadius="8" Padding="4">
      <ListBox x:Name="LogList" Background="Transparent" Foreground="#D6DCE5" BorderThickness="0"
               FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
